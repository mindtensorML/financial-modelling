# Copy to .env and fill in what you need. Everything is optional for local development.

# Where the SQLite database, uploaded originals, and the OCR model cache live.
DATA_DIR=./data

# Port for the API server (the Vite dev server proxies /api to it).
PORT=8787

# Set to true when serving over HTTPS so session cookies are marked Secure.
COOKIE_SECURE=false

# Behind a reverse proxy, tells rate limits where to find the visitor's address. "true" reads the
# first X-Forwarded-For entry; or name the header your host sets: fly-client-ip on Fly.io,
# cf-connecting-ip on Render. Only use a header the proxy overwrites, or visitors can fake it.
TRUST_PROXY=false

# "open" lets anyone create an account. "invite" only allows sign-ups that join an existing
# household with its invite code; switch to it once everyone in your household has an account.
SIGNUP_MODE=open

# AI extraction. Any OpenAI-compatible API works:
#   OpenAI:      AI_BASE_URL=https://api.openai.com/v1
#   OpenRouter:  AI_BASE_URL=https://openrouter.ai/api/v1
#   Ollama:      AI_BASE_URL=http://localhost:11434/v1  (AI_API_KEY can be any value)
# Leave AI_API_KEY empty to use on-device OCR and rule-based parsing only.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
# Model used for photos, screenshots, receipts, and free text. Must accept images and JSON-schema output.
AI_MODEL=gpt-4.1-mini
# Model used to transcribe voice notes. Leave empty if your provider has no transcription endpoint.
AI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Set to false to disable the OCR fallback (it downloads a 5 MB English model on first use).
OCR_ENABLED=true
